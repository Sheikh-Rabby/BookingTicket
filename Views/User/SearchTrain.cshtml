@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    /* Main container styling */
    .container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    /* Main card styling */
    .main-card {
        background: white;
        border-radius: 25px;
        border: none;
        overflow: hidden;
        animation: slideUp 0.6s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

   /*  .card-body {
        padding: 35px;
        background: #f8faff;
    } */

    /* Search form container */
    .search-form {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .form-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #eef2f7;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-title i {
            color: #667eea;
        }

    /* Station row styling */
    .station-row {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        flex-wrap: wrap;
    }

    .station-item {
        flex: 1;
        min-width: 200px;
    }

    .station-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #555;
        font-weight: 500;
        font-size: 0.9rem;
    }

        .station-label i {
            color: #667eea;
            font-size: 1rem;
        }

    .form-control, .form-select {
        border: 2px solid #eef2f7;
        border-radius: 15px;
        padding: 12px 18px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: white;
        width: 100%;
    }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
            outline: none;
        }

        .form-control::placeholder {
            color: #aaa;
            font-size: 0.9rem;
        }

    /* Swap button */
    .swap-btn {
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .swap-btn button {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: white;
            border: 2px solid #eef2f7;
            color: #667eea;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 25px;
        }

            .swap-btn button:hover {
                background: #667eea;
                color: white;
                border-color: #667eea;
                transform: rotate(180deg);
            }

    /* Date and Class row */
    .details-row {
        display: flex;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .details-item {
        flex: 1;
        min-width: 150px;
    }

    /* Search button */
    .search-btn-container {
        margin-top: 30px;
        text-align: center;
    }

    .btn-search {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 14px 45px;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
    }

        .btn-search:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(102, 126, 234, 0.4);
        }

        .btn-search i {
            font-size: 1.2rem;
        }

    /* Image styling - সরাসরি, কোন কার্ড ছাড়া */
    .train-image-container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
       /*  padding: 10px; */
    }

    .train-image {
        width: 100%;
        height: auto;
        max-height: 400px;
        object-fit: contain;
       /*  border-radius: 30px; */
        transition: transform 0.3s ease;
    }

        .train-image:hover {
            transform: scale(1.02);
        }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .card-body {
            padding: 20px;
        }

        .search-form {
            padding: 20px;
        }

        .station-row {
            flex-direction: column;
            gap: 10px;
        }

        .swap-btn button {
            margin-top: 0;
            transform: rotate(90deg);
        }

            .swap-btn button:hover {
                transform: rotate(270deg);
            }

        .train-image-container {
            margin-top: 20px;
        }

        .train-image {
            max-height: 250px;
        }
    }
</style>

<!-- Font Awesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="container">
    <!-- Main Card -->
    <section>
    <div class="card main-card">
        <div class="card-body">
            <div class="row">
                <!-- Left Column - Search Form -->
                <div class="col-md-6">
                    <div class="search-form">
                        <div class="form-title">
                            <i class="fas fa-search"></i>
                            Search Tickets
                        </div>

                        <!-- From - To Station Row -->
                        <div class="station-row">
                            <div class="station-item">
                                <div class="station-label">
                                    <i class="fas fa-circle-dot"></i>
                                    From
                                </div>
                                <input class="form-control" placeholder="from station" />
                            </div>

                            <div class="swap-btn">
                                <button type="button">
                                    <i class="fas fa-arrow-right-arrow-left"></i>
                                </button>
                            </div>

                            <div class="station-item">
                                <div class="station-label">
                                    <i class="fas fa-location-dot"></i>
                                    To
                                </div>
                                <input class="form-control" placeholder="to station" />
                            </div>
                        </div>

                        <!-- Date and Class Row -->
                        <div class="details-row">
                            <div class="details-item">
                                <div class="station-label">
                                    <i class="fas fa-calendar"></i>
                                    Journey Date
                                </div>
                                <input class="form-control" type="date" />
                            </div>
                            <div class="details-item">
                                <div class="station-label">
                                    <i class="fas fa-chair"></i>
                                    Class
                                </div>
                                <select class="form-select">
                                    <option value="" selected disabled>Select Class</option>
                                    <option value="1">AC Sleeper</option>
                                    <option value="2">AC Chair</option>
                                    <option value="3">Non-AC Sleeper</option>
                                    <option value="4">Non-AC Chair</option>
                                    <option value="5">Shovon</option>
                                </select>
                            </div>
                        </div>

                        <!-- Search Button -->
                        <div class="search-btn-container">
                            <button class="btn-search">
                                <i class="fas fa-magnifying-glass"></i>
                                Search Trains
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Train Image (কোন কার্ড নেই, শুধু ইমেজ) -->
                <div class="col-md-6">
                    <div class="train-image-container">
                        <img src="~/image/trainImage.webp"
                             alt="Bangladesh Railway Train"
                             class="train-image"
                             onerror="this.onerror=null; this.src='~/image/trainImage.jpg';" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    </section>
    <section></section>


</div>

<!-- Empty row for future use -->
<div class="row">
    <div class="col-md-4">
    </div>
</div>