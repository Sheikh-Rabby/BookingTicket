        font-size: 15px;
        font-weight: 600;
        color: #333;
    }

    .class-price {
        font-size: 18px;
        font-weight: 700;
        color: #28a745;
    }

    .price-note {
        font-size: 10px;
        color: #f57c00;
        font-weight: 400;
        margin-left: 3px;
    }

    .vat-info {
        font-size: 10px;
        color: #f57c00;
        margin: -2px 0 5px;
        font-style: italic;
    }

    .available-text {
        font-size: 10px;
        color: #666;
        margin: 5px 0 3px;
    }

    .ticket-count {
        font-size: 20px;
        font-weight: 700;
        color: #333;
        display: block;
        margin: 3px 0 8px;
    }

    .book-btn {
        background: #009688;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        font-size: 12px;
        transition: background 0.2s;
    }

        .book-btn:hover {
            background: #00796b;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .route-info

    {
        flex-direction: column;
        gap: 15px;
    }

    .class-section {
        flex-direction: column;
        align-items: center;
    }

    .class-card {
        max-width: 100%;
        width: 100%;
    }

    .train-time-section {
        flex-direction: column;
        gap: 15px;
    }

    .time-box, .time-box.right {
        text-align: center;
    }

    .duration {
        margin: 10px 0;
        width: 100%;
    }

    }
</style>

<div class="container">
    <!-- Header Card -->
    <div class="header-card">
        <div class="route-info">
            <div class="route-stations">
                <span>Dhaka</span> → <span>Tarakandi</span>
            </div>
            <button class="modify-search">Modify Search</button>
        </div>
    </div>

    <!-- Train Cards -->
    @foreach (var train in Model.TrainDetails)
    {
        <div class="train-card">
            <!-- Train Header -->
            <div class="train-header">
                <div class="train-title">
                    <h2>@train.TrainName <small>(@train.TrainName)</small></h2>
                    <div class="booking-info">0+ users are trying to book ticket(s)</div>
                </div>
                <div class="train-details-link">Train Details</div>
            </div>

            <!-- Journey Timeline -->
            <div class="train-time-section">
                <div class="time-box">
                    <div class="time">09 MAR, 10:00 AM</div>
                    <div class="station">Dhaka</div>
                </div>

                <div class="duration">
                    <div class="line"></div>
                    <span>05h 42m</span>
                </div>

                <div class="time-box right">
                    <div class="time">09 MAR, 03:42 PM</div>
                    <div class="station">Tarakandi</div>
                </div>
            </div>

            <!-- Classes Section - Smaller Cards -->
            <div class="class-section">
                @for (int i = 0; i < train.ClassName.Count; i++)
                {
                    var className = train.ClassName[i];
                    var isSpecial = className == "SNIGDHA";
                    var price = train.Price[i];

                    <div class="class-card @(isSpecial ? "special" : "")">
                        <div class="class-header">
                            <span class="class-name">@className</span>
                            <span class="class-price">
                                ৳@price
                                @if (isSpecial)
                                {
                                    <span class="price-note">+ VAT</span>
                                }
                            </span>
                        </div>

                        @if (isSpecial)
                        {
                            <div class="vat-info">Including VAT</div>
                        }

                        <div class="available-text">Available Tickets (Counter + Online)</div>
                        <span class="ticket-count">30</span>
                        <button class="book-btn">BOOK NOW</button>
                    </div>
                }
            </div>
        </div>
    }
