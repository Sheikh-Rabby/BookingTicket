<div class="container">
    <!-- Header Card -->
    <div class="header-card">
        <div class="route-info">
            
                <div class="route-stations">
                 <span>@Model.Trains.FirstOrDefault().from_station</span> → <span>@Model.Trains.FirstOrDefault().to_station</span> 
                </div>
            
            
            <a href="/User/SearchTrain" class="modify-search">Modify Search</a>
        </div>
    </div>

    <!-- Train Cards with Dropdown -->
    @foreach (var train in Model.Trains) 
    {
       

        <div class="train-card">
            <!-- Train Header - Clickable Dropdown -->
            <div class="train-header" onclick="toggleTrainDetails(this)">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="dropdown-icon">▼</span>
                    <div class="train-title">
                        <h2>@train.trainName <small>(@train.trainName)</small></h2>
                        <span class="booking-info">0+ users are trying to book ticket(s)</span>
                    </div>
                </div>
                <div class="train-details-link">Train Details</div>
            </div>
          
            <!-- Train Details - Hidden by default -->
            <div class="train-details">
                <!-- Journey Timeline -->
                <div class="train-time-section">
                    <div class="time-box">
                        <div class="time">09 MAR, 10:00 AM</div>
                        <div class="station">Dhaka</div>
                    </div>

                    <div class="duration">
                        <div class="line"></div>
                        <span>05h 42m</span>
                    </div>

                    <div class="time-box right">
                        <div class="time">09 MAR, 03:42 PM</div>
                        <div class="station">Tarakandi</div>
                    </div>
                </div>
                <hr />

                <!-- Classes Section -->
                <div class="class-section">

                    @for (int i = 0; i < train.Classes.Count;i++)
                    {
                        var className = train.Classes[i].className;
                        var price = train.Classes[i].price;
                        <div class="class-card">
                            <div class="class-header">
                                <span class="class-name">@className</span>
                                <span class="class-price">৳@price</span>
                            </div>
                            <div class="vat-info">Including VAT</div>
                            <div class="available-text">Available Tickets (Counter + Online)</div>
                            <span class="ticket-count">30</span>
                            <button class="book-btn">BOOK NOW</button>
                        </div>
                       
                    }
                   
                </div>
               
                <div class="seatDetails mt-4">
                    <hr />
                    <div class="status">
                        <div class="row">
                            <div class="col-md-4">
                                <label class="fw-bold">Select Coach</label>
                               
                                    <select class="form-select bogie-select" data-trainid="@train.trainId">
                                    @foreach (var bogie in train.Bogies)
                                    {
                                        <option value="@bogie.bogieID">@bogie.bogieName</option>
                                    }
                                    </select>
                                

                                      
                            </div>
                        </div>
                        <div class="row mt-3">
                            
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="statusBox"></div>
                                    <span>Available</span>
                                    <div class="statusBox1"></div>
                                    <span>Selected</span>
                                    <div class="statusBox2"></div>
                                    <span>In Progress</span>
                                    <div class="statusBox3"></div>
                                    <span>Booked</span>
                                </div>
                                <div class="seat_containar">

                                
                                <div class="seat-grid ">
                                    <!-- CHA-1 to CHA-40 manually -->
                                    @foreach (var bogie in train.Bogies)
                                    {
                                        @foreach (var seat in bogie.Seats)
                                        {
                                            <div class="seat-checkbox">
                                                <input type="checkbox"
                                                       id="seat_@seat.seatID"
                                                       value="@seat.seatID">
                                                <label for="seat_@seat.seatID" class="seat-label">
                                                    @seat.seatName
                                                </label>
                                            </div>
                                        }
                                    }
                                  @* 
                                    <div class="seat-checkbox">
                                        <input type="checkbox" id="seat38">
                                        <label for="seat38" class="seat-label">CHA-38</label>
                                    </div>
                                    <div class="seat-checkbox">
                                        <input type="checkbox" id="seat39">
                                        <label for="seat39" class="seat-label">CHA-39</label>
                                    </div>
                                    <div class="seat-checkbox">
                                        <input type="checkbox" id="seat40">
                                        <label for="seat40" class="seat-label">CHA-40</label>
                                    </div> *@

                                    
                                   </div>
                            </div>
                            <div>
                                <p>Coach : </p>
                            </div>

                                
                            </div>
                        </div>
                      
                    </div>
                </div>
            
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
    function toggleTrainDetails(header) {
        header.classList.toggle('active');
        var details = header.nextElementSibling;
        details.classList.toggle('show');
        var allHeaders = document.querySelectorAll('.train-header');
    }

    // ❌ Ei 2 line remove kora hoyeche - wrong syntax chilo
    // var maxcheckbox = document.getElementsByClassName('seat-checkbox')
    // maxcheckbox.value('maximun'=4)

    $(document).ready(function(){
        $('.seat-checkbox input[type="checkbox"]').on('change', function(){
            let maxSeat = 4;
            let checkedCount = $('.seat-checkbox input[type="checkbox"]:checked').length;
            if (checkedCount > maxSeat) {
                $(this).prop('checked', false);
                alert("You can select maximum 4 seats only!");
            }
        });
    });

    $('.bogie-select').on('change',function(){
        var selected=$(this).val()
        var trainId=$(this).data('trainid')
        console.log(selected)
        console.log(trainId)
    })


    window.onload = function() {
        var firstTrain = document.querySelector('.train-header');
        if(firstTrain) {
            firstTrain.classList.add('active');
            firstTrain.nextElementSibling.classList.add('show');
        }
    }
</script>