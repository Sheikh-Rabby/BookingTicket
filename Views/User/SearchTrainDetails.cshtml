<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #f5f5f5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    }

    /* .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
    } */

    /* Header Card */
    .header-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .route-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .route-stations {
        font-size: 18px;
        font-weight: 500;
        color: #333;
    }

        .route-stations span {
            color: #f57c00;
            margin: 0 5px;
        }

    .modify-search {
        background: #f57c00;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 25px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        border: 1px solid #f57c00;
    }

        .modify-search:hover {
            background: #e65100;
        }

    /* Train Card */
    .train-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    /* Train Header */
    .train-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .train-title h2 {
        font-size: 24px;
        font-weight: 600;
        color: #f57c00;
        margin: 0;
    }

        .train-title h2 small {
            font-size: 16px;
            color: #666;
            font-weight: 400;
            margin-left: 5px;
        }

    .booking-info {
        font-size: 13px;
        color: #28a745;
        margin-top: 5px;
    }

    .train-details-link {
        color: #009688;
        font-weight: 600;
        cursor: pointer;
        padding: 8px 16px;
        border-radius: 20px;
        background: #f8f9fa;
        font-size: 14px;
    }

        .train-details-link:hover {
            background: #e9ecef;
        }

    /* Journey Timeline */
    .train-time-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 25px 0;
        padding: 0 10px;
    }

    .time-box {
        text-align: left;
    }

        .time-box.right {
            text-align: right;
        }

    .time {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 5px;
    }

    .station {
        font-size: 14px;
        color: #666;
    }

    .duration {
        text-align: center;
        flex: 1;
        margin: 0 30px;
        position: relative;
    }

        .duration .line {
            height: 2px;
            background: #ddd;
            margin: 8px 0;
            position: relative;
        }

            .duration .line::before,
            .duration .line::after {
                content: '';
                position: absolute;
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #999;
                top: -3px;
            }

            .duration .line::before {
                left: 0;
            }

            .duration .line::after {
                right: 0;
            }

        .duration span {
            font-size: 13px;
            color: #666;
            background: #f8f9fa;
            padding: 2px 12px;
            border-radius: 12px;
        }

