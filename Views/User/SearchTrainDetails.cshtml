<script>
        function toggleTrainDetails(header) {
        header.classList.toggle('active');
        var details = header.nextElementSibling;
        details.classList.toggle('show');
    }

    function loadSeats(bogieId, trainId, price) {
        if (!bogieId) return;

        $.ajax({
            url: '/User/TrainSeatByBogie',
            type: 'GET',
            data: { bogieId: bogieId, trainId: trainId },
            success: function (response) {
                var seats = response.data || response;
                var seatLength = seats.length;

                var selectElement = $('.bogie-select[data-trainid="' + trainId + '"]');
                selectElement.find('option[value="' + bogieId + '"]').each(function () {
                    var bogieName = $(this).text().split('(')[0].trim();
                    $(this).text(bogieName + ' (' + seatLength + ')');
                });

                var html = '';
                seats.forEach(function (b) {
                    html += `
                        <div class="seat-checkbox" data-bogieid="${bogieId}" data-price="${price}" style="display:none">
                            <input type="checkbox"
                                   id="${trainId}_${bogieId}_${b.seatID}"
                                   value="${b.seatID}">
                            <label for="${trainId}_${bogieId}_${b.seatID}" class="seat-label">
                                ${b.seatName}
                            </label>
                        </div>`;
                });

                $('#seatGrid_' + trainId).append(html);

                // ✅ Load হওয়ার পর show করো
                $('#seatGrid_' + trainId).find('.seat-checkbox').hide();
                $('#seatGrid_' + trainId).find('.seat-checkbox[data-bogieid="' + bogieId + '"]').show();
            },
            error: function () {
                alert('Error loading seats!');
            }
        });
    }

    function loadBogie(classId, trainId, price) {
        $('#seatGrid_' + trainId).empty();
        $('.bogie-select[data-trainid="' + trainId + '"]').empty();

        $.ajax({
            url: '/User/TrainBogieByClass',
            type: 'GET',
            data: { classId: classId, trainId: trainId },
            success: function (response) {
                var bogies = response.data || response;

                var html = '';
                bogies.forEach(function (b) {
                    html += `<option value="${b.bogieID}">${b.bogieName}</option>`;
                });

                $('.bogie-select[data-trainid="' + trainId + '"]').html(html);

                // ✅ শুধু প্রথম bogie load করো
                if (bogies.length > 0) {
                    loadSeats(bogies[0].bogieID, trainId, price);
                }
            }
        });
    }

    // ✅ Checkbox change
    document.addEventListener('change', function (e) {
        if (e.target.type === 'checkbox') {
            var seatCheckbox = $(e.target).closest('.seat-checkbox');
            var seatid = e.target.value;

            // ✅ closest train-card থেকে trainId নাও
            var trainId = $(e.target).closest('.train-card')
                            .find('.bogie-select').data('trainid');

            var seatName = $(`label[for="${e.target.id}"]`).text().trim();
            var seatPrice = seatCheckbox.data('price');

            // ✅ এই train এর select_seat_row target করো
            var seatRow = $(e.target).closest('.train-card').find('.select_seat_row');
            var priceDisplay = $(e.target).closest('.train-card').find('#price');

            if (e.target.checked) {
                // ✅ Max 4 check
                var checkedCount = $(e.target).closest('.train-card')
                                    .find('.seat-checkbox input[type="checkbox"]:checked').length;
                if (checkedCount > 4) {
                    e.target.checked = false;
                    alert("You can select maximum 4 seats only!");
                    return;
                }

                // ✅ Duplicate check
                if (seatRow.find('.ticket_item[data-seat="' + seatid + '"]').length === 0) {
                    seatRow.append(`
                        <div class="ticket_item" data-seat="${seatid}" data-trainid="${trainId}">
                            <span value="${seatid}" class="seat_no">${seatName}</span>
                            <span class="price">${seatPrice}</span>
                        </div>`);
                }
            } else {
                seatRow.find('.ticket_item[data-seat="' + seatid + '"]').remove();
            }

            // ✅ Total price update
            var total = 0;
            seatRow.find('.ticket_item .price').each(function () {
                total += parseFloat($(this).text()) || 0;
            });
            priceDisplay.text(total.toFixed(2));

            console.log('Seat Count:', seatRow.find('.ticket_item').length);
            console.log('Total Price:', total);
        }
    });

    $(document).ready(function () {

        // ✅ Bogie Change - lazy load
        $(document).on('change', '.bogie-select', function () {
            var bogieId = $(this).val();
            var trainId = $(this).data('trainid');
            var price = $(this).closest('.train-details')
                            .find('.class-card.active-card .class-price')
                            .text().trim().replace('৳', '');

            var alreadyLoaded = $('#seatGrid_' + trainId)
                .find('.seat-checkbox[data-bogieid="' + bogieId + '"]').length > 0;

            $('#seatGrid_' + trainId).find('.seat-checkbox').hide();

            if (!alreadyLoaded) {
                // ✅ এখনো load হয়নি, load করো
                loadSeats(bogieId, trainId, price);
            } else {
                // ✅ Already loaded, শুধু show করো
                $('#seatGrid_' + trainId)
                    .find('.seat-checkbox[data-bogieid="' + bogieId + '"]').show();
            }
        });

        // ✅ Book Now click
        $(document).on('click', '.book-btn', function () {
            var card = $(this).closest('.class-card');
            var seatSection = card.closest('.train-details').find('.seatDetails');
            var trainId = card.data('trainid');
            var classId = card.data('id');
            var price = card.find('.class-price').text().trim().replace('৳', '');

            if (card.hasClass('active-card')) {
                card.removeClass('active-card');
                seatSection.slideUp();
            } else {
                $('.class-card').removeClass('active-card');
                $('.seatDetails').slideUp();
                card.addClass('active-card');
                seatSection.slideDown();
                loadBogie(classId, trainId, price);
            }
        });

        // ✅ Initial Class Auto Select
        var selectedClassId = '@selectedClassId';

        if (selectedClassId) {
            var firstTrain = $('.train-card').first();
            $('.class-card').removeClass('active-card');
            $('.seatDetails').hide();

            var card = firstTrain.find('.class-card').filter(function () {
                return $(this).data('classid') &&
                    $(this).data('classid').toString().trim().toLowerCase() ===
                    selectedClassId.toString().trim().toLowerCase();
            }).first();

            if (card.length) {
                card.addClass('active-card');
                firstTrain.find('.seatDetails').slideDown();
                var classId = card.data('id');
                var trainId = card.data('trainid');
                var price = card.find('.class-price').text().trim().replace('৳', '');
                loadBogie(classId, trainId, price);
            }
        }
    });

    // ✅ First Train Auto Open
    window.onload = function () {
        var firstTrain = document.querySelector('.train-header');
        if (firstTrain) {
            firstTrain.classList.add('active');
            firstTrain.nextElementSibling.classList.add('show');
        }
    }
</script>