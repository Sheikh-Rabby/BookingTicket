        margin: 3px 0 8px;
    }

    .statusBox {
        width: 20px;
        height: 20px;
        background: white;
        border: 1px solid black;
        border-radius: 5px;
    }

    .statusBox1 {
        width: 20px;
        height: 20px;
        background: #151854;
        border-radius: 5px;
    }

    .statusBox2 {
        width: 20px;
        height: 20px;
        background: #5bb450;
        border-radius: 5px;
    }

    .statusBox3 {
        width: 20px;
        height: 20px;
        background: #f57c00;
        border-radius: 5px;
    }

    .seat-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        border-radius: 10px;
    }

    .seat-checkbox {
        position: relative;
        width: 100%;
        
        aspect-ratio: 1;
    }

        .seat-checkbox input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
            z-index: 2;
        }

        .seat-checkbox .seat-label {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            background: white;
            border: 1px solid black;
            border-radius: 18px;
            font-size: 12px;
            font-weight: 500;
            color: black;
            transition: all 0.2s;
        }

        .seat-checkbox input[type="checkbox"]:checked + .seat-label {
            background: #151854;
            color: white;
        }

    .seat_containar {
        width: 400px;
        height:700px;
        border: 1px solid #666362;
        padding: 40px;
        margin-top: 30px;
    }

    .select_ticket_containar {
        width: 500px;
        height: 300px;
        background-color: white;
        margin-left: 80px;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .ticket_header {
        background: #E7E7E7;
        color: black;
        padding: 12px;
        text-align: center;
        font-weight: 600;
    }

    .select_seat_row {
        padding: 15px;
    }

    .ticket_item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8f9fa;
        padding: 10px 15px;
        border-radius: 8px;
        margin-bottom: 10px;
        transition: 0.2s;
    }

    .book-btn {
        background: #009688;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        font-size: 12px;
        transition: background 0.2s;
    }

        .book-btn:hover {
            background: #00796b;
        }

    @@media (max-width: 768px) {
        .route-info {
            flex-direction: column;
            gap: 15px;
        }

        .train-title {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }

        .class-section {
            flex-direction: column;
            align-items: center;
        }

        .class-card {
            max-width: 100%;
            width: 100%;
        }

        .train-time-section {
            flex-direction: column;
            gap: 15px;
        }

        .time-box, .time-box.right {
            text-align: center;
        }

        .duration {
            margin: 10px 0;
            width: 100%;
        }
    }
</style>

<div class="container">
    <div class="header-card">
        <div class="route-info">
            <div class="route-stations">
                <span>@Model.Trains.FirstOrDefault().from_station</span> → <span>@Model.Trains.FirstOrDefault().to_station</span>
            </div>
            <a href="/User/SearchTrain" class="modify-search">Modify Search</a>
        </div>
    </div>

    @foreach (var train in Model.Trains)
    {
        <div class="train-card">
            <div class="train-header" onclick="toggleTrainDetails(this)">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span class="dropdown-icon">▼</span>
                    <div class="train-title" data-trainid="@train.trainId">
                        <h2>@train.trainName <small>(@train.trainId)</small></h2>
                        <span class="booking-info">0+ users are trying to book ticket(s)</span>
                    </div>
                </div>
                <div class="train-details-link">Train Details</div>
            </div>

            <div class="train-details">
                <div class="train-time-section">
                    <div class="time-box">
                        <div class="time">09 MAR, 10:00 AM</div>
                        <div class="station">@train.from_station</div>
                    </div>
                    <div class="duration">
                        <div class="line"></div>
                        <span>05h 42m</span>
                    </div>
                    <div class="time-box right">
                        <div class="time">09 MAR, 03:42 PM</div>
                        <div class="station">@train.to_station</div>
                    </div>
                </div>
                <hr />

                <div class="class-section">
                    @for (int i = 0; i < train.Classes.Count; i++)
                    {
                        var className = train.Classes[i].className;
                        var price = train.Classes[i].price;
                        <div class="class-card" data-classId="@train.Classes[i].className" data-id="@train.Classes[i].classID" data-trainid="@train.trainId">
                            <div class="class-header">
                                <span class="class-name booking-info">@className</span>
                                <span class="class-price">৳@price</span>
                            </div>
                            <div class="vat-info">Including VAT</div>
                            <div class="available-text">Available Tickets (Counter + Online)</div>
                            <span class="ticket-count">30</span>
                            <button class="book-btn">BOOK NOW</button>
                        </div>
                    }
                </div>

                <div class="seatDetails mt-4" style="display:none">
                    <hr />
                    <div class="status">
                        <div class="row">
                            <div class="col-md-4">
                                <label class="fw-bold">Select Coach</label>
                                <select class="form-select bogie-select" data-trainid="@train.trainId">
                                </select>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="d-flex gap-3 align-items-center">
                                <div class="statusBox"></div>
                                <span style="font-size: 11px;">Available</span>
                                <div class="statusBox1"></div>
                                <span style="font-size: 11px;">Selected</span>
                                <div class="statusBox2"></div>
                                <span style="font-size: 11px;">In Progress</span>
                                <div class="statusBox3"></div>
                                <span style="font-size: 11px;">Booked</span>
                            </div>
                        </div>
                         <div class="d-flex">

                              <div class="seat_containar">
                                <div class="seat-grid" id="seatGrid_@train.trainId">
                                </div>
                            </div>
                            <div class="select_ticket_containar mt-4" style="margin-left:100px">
                                <header>
                                    <h5 class="ticket_header">Tickets</h5>
                                </header>
                                <div class="select_seat_row mb-4">
                                  
                                </div>
                                <hr/>

                                <div class="p-3">
                                    <h5>Total : </h5>
                                    <span id="price">0.00</span>
                                </div>
                            </div>
                        </div>

                            @* <div class="mt-1" >
                                <p class="">Coach : <span class="booking-info" id="coach"></span></p>
                            </div> *@
                        
                    </div>
                </div>
            </div>
        </div>
    }
</div>

